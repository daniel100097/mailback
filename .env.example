PORT=3000
DATABASE_PATH=./data/mailback.db
MIGRATIONS_DIR=./drizzle
# Minutes between automatic syncs of all enabled accounts (0 disables)
SYNC_INTERVAL_MINUTES=60
# Key that encrypts stored IMAP passwords: base64 of 32 random bytes, e.g. `openssl rand -base64 32`.
# If unset, one is generated at SECRET_KEY_PATH (next to the database).
# MAILBACK_SECRET=
SECRET_KEY_PATH=./data/secret.key
# Login password: output of `bun run hash-password`. Use the base64 form here, since Bun expands `$` in .env
# values. If unset, the UI and API are open to anyone who can reach the server.
# MAILBACK_PASSWORD_HASH=
# Never write to IMAP servers: restore is disabled and folders are opened read-only. Everything else works.
# MAILBACK_READ_ONLY=true
