{
  "name": "mailback",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.ts",
    "build": "bun run build.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "hash-password": "bun scripts/hash-password.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "test": "bun test",
    "test:e2e": "docker compose -f compose.test.yaml run --rm e2e; docker compose -f compose.test.yaml down"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@tanstack/react-query": "^5.103.2",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "client-zip": "^2.5.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.3",
    "imapflow": "^2.0.6",
    "lucide-react": "^1",
    "minisearch": "^7.2.0",
    "postal-mime": "^3.0.0",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "tailwindcss": "^4.1.11",
    "typescript": "^7"
  }
}
